#!/bin/sh
# Lumen console session: start the daemon, then gamescope running the shell.
set -eu

export XDG_CURRENT_DESKTOP=Lumen
export XDG_SESSION_TYPE=wayland
export LUMEN_PORT="${LUMEN_PORT:-7777}"

if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
	systemctl --user import-environment XDG_CURRENT_DESKTOP XDG_SESSION_TYPE LUMEN_PORT
	systemctl --user start lumend.service
else
	lumend &
fi

# Run a client fullscreen. gamescope needs Vulkan; on VMs and GPUs without
# it, it exits straight away, so fall back to cage (plain Wayland kiosk).
# LUMEN_GAMESCOPE_ARGS lets a user force e.g. "-W 1920 -H 1080 -r 60";
# it is unquoted on purpose so it word-splits.
fullscreen() {
	started=$(date +%s)
	# shellcheck disable=SC2086
	gamescope ${LUMEN_GAMESCOPE_ARGS:-} --adaptive-sync -- "$@" && exit 0
	if [ $(($(date +%s) - started)) -lt 15 ]; then
		echo "lumen-session: gamescope failed, using cage" >&2
		exec cage -s -- "$@"
	fi
	exit 1
}

# On the live ISO, the first screen is the installer (first-start style).
# It is provided by the installer package as lumen-installer-session.
# Booting with lumen.skip_installer goes straight to the shell.
if [ -d /run/archiso ] && command -v lumen-installer-session >/dev/null 2>&1 &&
	[ -z "${LUMEN_SKIP_INSTALLER:-}" ] && ! grep -qw lumen.skip_installer /proc/cmdline; then
	fullscreen lumen-installer-session
fi

fullscreen lumen-ui
