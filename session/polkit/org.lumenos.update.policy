<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Lets Settings › System update run its root helper through pkexec. -->
<policyconfig>
  <vendor>Lumen OS</vendor>
  <action id="org.lumenos.update">
    <description>Update Lumen OS</description>
    <message>Authentication is required to update the system</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/lumen/lumen-update-system</annotate>
  </action>
</policyconfig>
