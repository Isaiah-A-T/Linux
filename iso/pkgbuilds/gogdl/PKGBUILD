# GOG downloader used by Heroic; Lumen uses it directly for GOG accounts.
pkgname=gogdl
pkgver=r0
pkgrel=1
pkgdesc="GOG download and launch helper (from the Heroic project)"
arch=('x86_64')
url="https://github.com/Heroic-Games-Launcher/heroic-gogdl"
license=('GPL-3.0-only')
depends=('python' 'python-requests')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
	cd heroic-gogdl
	printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
	# The xdelta3 C extension's sources are a git submodule.
	cd heroic-gogdl
	git submodule update --init --recursive
}

build() {
	cd heroic-gogdl
	python -m build --wheel --no-isolation
}

package() {
	cd heroic-gogdl
	python -m installer --destdir="$pkgdir" dist/*.whl
}
